		"@electron/fuses": "^1.8.0",
		"@eslint/js": "^10.0.1",
		"@types/electron-squirrel-startup": "^1.0.2",
		"electron": "41.5.0",
		"eslint": "^10.1.0",
		"globals": "^17.6.0",
		"prettier": "3.8.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.59.1",
