		"package": "electron-forge package",
		"make": "electron-forge make",
		"publish": "electron-forge publish",
		"generate-icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-app-icons.ps1",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": {
		"name": "AurLemon",
		"email": "aurlemoncn@gmail.com"
	},
	"license": "MIT",
