{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"types": ["electron"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "forge.env.d.ts"],
	"exclude": ["dist", "out", "node_modules", "**/*.timestamp-*.mjs"]
}
